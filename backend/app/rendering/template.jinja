<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quote Render</title>
    <style>
        /* Google Fonts import removed to prevent Playwright timeout; relying on local base64 font */
        {% if font_b64 %}
        @font-face {
            font-family: '{{ style.text.font_family }}';
            src: url(data:font/truetype;charset=utf-8;base64,{{ font_b64 }}) format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        {% endif %}

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            width: {{ style.canvas.width }}px;
            height: {{ style.canvas.height }}px;
            background-color: {{ style.outer_background }};
            display: flex;
            flex-direction: column;
            align-items: center;
            font-family: '{{ style.text.font_family }}', sans-serif;
            position: relative;
        }

        /* Profile Header */
        .profile-header {
            width: 100%;
            height: 150px;
            display: flex;
            align-items: center;
            padding: 0 60px;
            color: white;
            gap: 20px;
        }

        .profile-pic {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #333;
        }

        .profile-info {
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .profile-name {
            font-size: 28px;
            font-weight: 700;
        }

        .profile-username {
            font-size: 20px;
            color: #888;
        }

        .menu-icon {
            font-size: 30px;
            letter-spacing: 2px;
            color: white;
            margin-bottom: 20px;
        }

        /* Main Card */
        .main-card {
            width: 960px;
            height: 850px;
            background-color: {{ style.card.background }};
            border-radius: {{ style.card.radius }}px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 80px;
            text-align: center;
            position: relative;
        }

        /* Quote Typography */
        .quote-text {
            color: {{ style.text.color }};
            font-family: '{{ style.text.font_family }}', sans-serif;
            font-size: {{ layout.font_size }}px;
            font-weight: {{ style.text.font_weight }};
            text-align: {{ style.text.align }};
            line-height: 1.2;
            /* We use nowrap so Playwright never wraps lines natively. 
               The Python TextLayoutEngine already calculated exact line breaks (<br>) */
            white-space: nowrap;
        }

        /* Author and Source */
        .attribution {
            position: absolute;
            bottom: 60px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .author {
            font-size: 32px;
            font-weight: 600;
            color: #333;
        }

        .source {
            font-size: 24px;
            color: #777;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
    </style>
</head>
<body>

    <div class="profile-header">
        {% if profile_img_b64 %}
        <img src="data:image/jpeg;base64,{{ profile_img_b64 }}" class="profile-pic" alt="Profile">
        {% endif %}
        <div class="profile-info">
            <div class="profile-name">{{ profile.name }}</div>
            <div class="profile-username">{{ profile.username }}</div>
        </div>
        <div class="menu-icon">•••</div>
    </div>

    <div class="main-card">
        <div class="quote-text" id="quoteText">
"{% for line in layout.lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}"
        </div>

        <div class="attribution">
            {% if author %}
            <div class="author">— {{ author }}</div>
            {% endif %}
            
            {% if source %}
            <div class="source">{{ source }}</div>
            {% endif %}
        </div>
    </div>
</body>
</html>
